---
export type SeaCreatureName = 'whale' | 'fish' | 'sealion';

interface Props {
  name: SeaCreatureName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const viewBoxes: Record<SeaCreatureName, string> = {
  whale: '0 0 260 130',
  fish: '0 0 140 90',
  sealion: '0 0 200 130',
};
---

<svg
  viewBox={viewBoxes[name]}
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'whale' && (
    <>
      <path
        d="M10,80 C10,55 35,45 70,44
           C110,43 150,48 185,58
           C195,60 200,64 198,70
           L225,55 L212,78 L232,92 L200,84
           C190,92 165,98 130,99
           C90,100 45,97 22,88
           C14,85 10,83 10,80 Z"
      />
      <path d="M80,44 C82,30 86,20 92,10" />
      <path d="M92,10 C94,20 98,28 106,34" />
      <path d="M92,10 C88,20 86,28 88,36" />
      <circle cx="150" cy="55" r="2.8" fill="currentColor" stroke="none" />
      <path d="M25,72 C33,76 42,76 50,72" />
    </>
  )}

  {name === 'fish' && (
    <>
      <path d="M15,45 C15,25 35,15 62,15 C88,15 105,28 112,45 C105,62 88,75 62,75 C35,75 15,65 15,45 Z" />
      <path d="M110,45 L132,25 L132,65 Z" />
      <path d="M55,15 L62,2 L70,15" />
      <path d="M40,40 C48,44 56,44 64,40" />
      <path d="M35,55 C43,59 51,59 59,55" />
      <circle cx="35" cy="35" r="3" fill="currentColor" stroke="none" />
    </>
  )}

  {name === 'sealion' && (
    <>
      <path
        d="M25,95 C10,85 8,65 22,52 C32,44 44,44 50,52
           C55,40 68,32 80,36 C90,40 92,50 86,58
           C115,58 150,68 168,85 C178,95 168,105 150,100
           C130,115 80,118 50,112 C35,109 25,103 25,95 Z"
      />
      <path d="M40,58 C30,65 25,75 28,85" />
      <circle cx="72" cy="46" r="2.5" fill="currentColor" stroke="none" />
      <path d="M58,52 L50,50 M58,55 L48,56 M58,58 L50,62" />
      <path d="M100,60 C108,66 110,74 105,80" />
    </>
  )}
</svg>
