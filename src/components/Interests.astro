---
import BackgroundIllustration from './ui/BackgroundIllustration.astro';

const interests = [
  {
    title: 'Surfistas',
    text: 'A pocos minutos en auto de las playas y balnearios del sur, ideal si venís a meterte al agua.',
  },
  {
    title: 'Nómadas digitales',
    text: 'WiFi de alta velocidad en una zona residencial tranquila, lejos del ajetreo del centro, para laburar sin apuro.',
  },
  {
    title: 'Grupos y amigos',
    text: 'Casas para hasta 5 personas, pensadas para compartir unos días con amigos o en familia.',
  },
];
---

<section class="relative overflow-hidden px-5 py-20 sm:px-8 sm:py-28">
  <BackgroundIllustration
    src="/images/Ilustraciones/medusa.png"
    class="absolute -bottom-8 -right-10 w-90 -rotate-6 opacity-[0.08] sm:w-140"
  />
  <div class="relative mx-auto max-w-6xl">
    <p class="text-center text-sm font-medium uppercase tracking-[0.2em] text-stone-400">
      Para quién
    </p>
    <h2 class="font-display mt-3 text-center text-3xl font-medium text-stone-900 sm:text-4xl">
      Ideal si venís...
    </h2>

    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      {interests.map((item) => (
        <div class="rounded-3xl bg-white p-6 ring-1 ring-stone-100">
          <h3 class="font-display text-lg font-medium text-stone-900">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
