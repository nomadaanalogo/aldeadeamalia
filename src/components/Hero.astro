---
import { Image } from 'astro:assets';
import { SITE } from '../config/properties';
import AmenityIcon from './ui/AmenityIcon.astro';
import StatIcon from './ui/StatIcon.astro';
import hero1 from '../assets/hero/hero-1.webp';
import hero2 from '../assets/hero/hero-2.webp';
import hero3 from '../assets/hero/hero-3.webp';

// Las fotos son verticales: en pantallas anchas van tres en fila (collage) para no
// estirar una sola; en mobile se muestran de a una, pasando con un fundido.
const photos = [
  { src: hero1, alt: 'Frente de una de las casas, con canteros de flores' },
  { src: hero3, alt: 'Parque con pasto y árboles de La Aldea de Amalia' },
  { src: hero2, alt: 'Frente de una de las casas y el jardín' },
];
---

<section id="top" class="relative flex min-h-[92svh] items-end overflow-hidden bg-stone-950 sm:min-h-[85vh]">
  {/* Mobile: slideshow */}
  <div class="absolute inset-0 md:hidden">
    {
      photos.map((photo, i) => (
        <Image
          src={photo.src}
          alt={i === 0 ? photo.alt : ''}
          class="hero-slide absolute inset-0 h-full w-full object-cover"
          style={`animation-delay: ${i * 6 - 1}s`}
          widths={[480, 960]}
          sizes="100vw"
          format="webp"
          quality="high"
          priority={i === 0}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))
    }
  </div>
  {/* Desktop/tablet: collage */}
  <div class="absolute inset-0 hidden grid-cols-3 gap-1 md:grid">
    {
      photos.map((photo) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          class="h-full w-full object-cover"
          widths={[480, 960]}
          sizes="34vw"
          format="webp"
          quality="high"
          priority
        />
      ))
    }
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/50 via-45% to-transparent"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-14 pt-32 sm:px-8 sm:pb-20">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-white/90 drop-shadow-md">
      Reservá por WhatsApp
    </p>
    <h1 class="font-display max-w-2xl text-4xl font-medium leading-[1.1] text-white drop-shadow-md sm:text-5xl md:text-6xl">
      Vení a descansar al sur de Mar del Plata
    </h1>
    <p class="mt-5 max-w-lg text-base leading-relaxed text-white/90 drop-shadow-md sm:text-lg">
      {SITE.description}
    </p>

    <ul class="mt-6 flex flex-wrap gap-2 text-sm font-medium text-white">
      <li class="flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-inset ring-white/25 backdrop-blur-sm">
        <StatIcon icon="guests" class="h-4 w-4" />
        Hasta 5 huéspedes
      </li>
      <li class="flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-inset ring-white/25 backdrop-blur-sm">
        <AmenityIcon icon="parking" class="h-4 w-4" />
        Cochera
      </li>
      <li class="flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-inset ring-white/25 backdrop-blur-sm">
        <AmenityIcon icon="wifi" class="h-4 w-4" />
        WiFi
      </li>
      <li class="flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-inset ring-white/25 backdrop-blur-sm">
        <AmenityIcon icon="grill" class="h-4 w-4" />
        Parrilla
      </li>
    </ul>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="#reservar"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-center text-sm font-semibold text-stone-900 transition hover:bg-stone-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
        Ver disponibilidad
      </a>
      <a
        href="#casas"
        class="rounded-full px-6 py-3.5 text-center text-sm font-semibold text-white ring-1 ring-inset ring-white/40 transition hover:bg-white/10"
      >
        Conocer las casas
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* Slideshow del hero en mobile: 3 fotos de 6 s, con fundido y un zoom lento. */
  .hero-slide {
    opacity: 0;
    animation: hero-slide 18s linear infinite both;
  }
  @keyframes hero-slide {
    0% {
      opacity: 0;
      transform: scale(1);
    }
    6% {
      opacity: 1;
    }
    33% {
      opacity: 1;
    }
    40% {
      opacity: 0;
      transform: scale(1.1);
    }
    100% {
      opacity: 0;
      transform: scale(1.1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
    }
    .hero-slide:first-child {
      opacity: 1;
    }
  }
</style>
