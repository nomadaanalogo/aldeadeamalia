---
import { Image } from 'astro:assets';
import { SITE } from '../config/properties';
// TODO: cuando haya fotos de Casa A, evaluar si conviene rotar la portada o sumar más variedad acá.
// Recorte propio de fachada.jpg (misma foto, con menos cielo/pasto) pensado para el hero angosto de mobile.
import coverPhoto from '../assets/properties/casa-b/hero-fachada.jpg';
---

<section id="top" class="relative flex min-h-[92svh] items-end overflow-hidden sm:min-h-[85vh]">
  <Image
    src={coverPhoto}
    alt="Fachada y jardín de una de las casas de La Aldea de Amalia"
    class="absolute inset-0 h-full w-full object-cover"
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
    format="webp"
    quality="high"
    priority
  />
  <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/55 to-stone-950/20"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-14 pt-32 sm:px-8 sm:pb-20">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-white/90 drop-shadow-sm">
      Reservá por WhatsApp
    </p>
    <h1 class="font-display max-w-2xl text-4xl font-medium leading-[1.1] text-white drop-shadow-sm sm:text-5xl md:text-6xl">
      Vení a descansar al sur de Mar del Plata
    </h1>
    <p class="mt-5 max-w-lg text-base leading-relaxed text-white/90 drop-shadow-sm sm:text-lg">
      {SITE.description}
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="#reservar"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-center text-sm font-semibold text-stone-900 transition hover:bg-stone-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
        Ver disponibilidad
      </a>
      <a
        href="#casas"
        class="rounded-full px-6 py-3.5 text-center text-sm font-semibold text-white ring-1 ring-inset ring-white/40 transition hover:bg-white/10"
      >
        Conocer las casas
      </a>
    </div>
  </div>
</section>
