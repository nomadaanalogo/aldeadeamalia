---
import { SITE } from '../config/properties';
import BackgroundIllustration from './ui/BackgroundIllustration.astro';

const highlights = [
  'Zona residencial y tranquila',
  'A pocos minutos en auto de las playas y balnearios del sur (zona Punta Mogotes)',
  'Cerca de Mute y la costa sur',
  'Fácil acceso en auto y transporte público',
];
---

<section id="ubicacion" class="relative overflow-hidden px-5 py-20 sm:px-8 sm:py-28">
  <BackgroundIllustration
    src="/images/Ilustraciones/lobo-marino.png"
    class="absolute top-6 -left-4 w-105 rotate-3 opacity-[0.09] sm:w-180 sm:-left-20"
  />
  <div class="relative mx-auto max-w-6xl grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-400">Ubicación</p>
      <h2 class="font-display mt-3 text-3xl font-medium text-stone-900 sm:text-4xl">
        Sur de Mar del Plata
      </h2>
      <p class="mt-4 leading-relaxed text-stone-600">
        Las dos casas están en una zona residencial tranquila del sur de Mar del Plata, a pocos
        minutos en auto de las playas y balnearios del sur, la zona de Punta Mogotes y Mute.
      </p>
      <ul class="mt-6 space-y-3 text-sm text-stone-700">
        {highlights.map((item) => (
          <li class="flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-stone-400"></span>
            {item}
          </li>
        ))}
      </ul>

      <a
        href={SITE.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block text-sm font-medium text-sky-700 underline underline-offset-2 hover:text-sky-800"
      >
        Ver en Google Maps
      </a>
    </div>

    <div class="aspect-square overflow-hidden rounded-3xl ring-1 ring-stone-200 sm:aspect-4/3">
      <iframe
        title={`Mapa de ${SITE.name}`}
        src={`https://www.google.com/maps?q=${SITE.coords.lat},${SITE.coords.lng}&z=16&output=embed`}
        class="h-full w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
